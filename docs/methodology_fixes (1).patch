+def test_headline_summary_new_outputs(model, tmp_path):
+    import summarize_results as sr
+    A, X, ext, (detail, summary, fd, ddetail, dsummary) = run(model)
+    summary.to_csv(tmp_path / sr.UPSTREAM_SUMMARY, index=False)
